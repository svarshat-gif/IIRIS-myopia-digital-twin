# Development defaults; ENVIRONMENT=production activates startup validation.
APP_NAME=Iiris API
PRODUCT_NAME=Iiris
API_VERSION=0.1.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./artifacts/myopia_twin.db
ARTIFACTS_DIR=./artifacts
MODEL_BUNDLE_NAME=progression_model.joblib
# Production: >=32 random characters, required. Never put this in the frontend.
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
# jwt: all private data requires user login/RBAC. api_key: extra server-side gate.
AUTH_GATE=jwt
API_KEY=
# Production: comma-separated explicit HTTPS origins; no wildcard.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BYTES=11534336
# Production requires s3 plus ALL five fields below. Private bucket only.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest
PUBMED_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_API_KEY=
EVIDENCE_CONTACT_EMAIL=
EVIDENCE_TIMEOUT_SECONDS=8
EVIDENCE_OFFLINE=false
# none (default) or Ollama on a LOOPBACK address only; no remote providers.
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT_SECONDS=60
# Optional CLI-only account setup (never read by the frontend).
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=
DEMO_PASSWORD=
