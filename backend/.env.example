# Copy to .env and edit. Every value here is a safe local default.

# --- App ---
ENVIRONMENT=development

# --- Database ---
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./artifacts/myopia_twin.db
# PostgreSQL (pip install "psycopg[binary]" first):
# DATABASE_URL=postgresql+psycopg://myopia:myopia@localhost:5432/myopia_twin

# --- Security ---
# Leave EMPTY for local development. Set a long random value before exposing the
# API anywhere. Clients then send it as the  X-API-Key  header.
API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Evidence retrieval ---
# true = never call the network, use the bundled corpus (good for offline demos)
EVIDENCE_OFFLINE=false
# Optional: raises the PubMed rate limit from 3 to 10 requests/second.
NCBI_API_KEY=
EVIDENCE_CONTACT_EMAIL=

# --- Agent LLM (entirely optional) ---
# none      -> deterministic answers only (default; the demo works fully like this)
# ollama    -> local model, no API bill, data stays on your machine
# openai_compatible -> any OpenAI-compatible endpoint
LLM_PROVIDER=none
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
